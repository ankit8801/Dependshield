# DependShield — Docker environment for LOCAL development/testing
#
# This file is used by docker-compose by default when no .env is present.
# It uses INTENTIONALLY WEAK credentials that are ONLY suitable for local
# docker-compose testing. NEVER use these values in production.
#
# For production: copy backend/.env.example to .env and set real secrets.

NODE_ENV=production

# Database
POSTGRES_USER=dependshield
POSTGRES_PASSWORD=dev_password_local_only
POSTGRES_DB=dependshield_db
DB_PORT=5432

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://dependshield:dev_password_local_only@db:5432/dependshield_db
JWT_SECRET=local_docker_jwt_secret_not_for_production_use_change_me
CORS_ORIGIN=http://localhost:80

# Frontend
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000/api/v1

# Integrations (optional for local testing)
GITHUB_TOKEN=
NVD_API_KEY=
