# DependShield — Environment Variable Reference
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# For Docker Compose, copy to .env in the project root (next to docker-compose.yml).
# For local development, copy to backend/.env.

# ─── Node.js Environment ──────────────────────────────────────────────────────
# Options: development | production | test
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by docker-compose to configure the postgres container.
POSTGRES_USER=dependshield
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dependshield_db

# Port to expose PostgreSQL on the host (default 5432).
# Change if you have a local Postgres instance already using 5432.
DB_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
# Host port for the backend API (default 3000).
BACKEND_PORT=3000

# Full Prisma connection string.
# In Docker Compose this is auto-assembled from the POSTGRES_* vars above.
# For local development, set this directly in backend/.env:
#   DATABASE_URL=postgresql://dependshield:password@localhost:5432/dependshield_db
DATABASE_URL=postgresql://dependshield:CHANGE_ME_STRONG_PASSWORD@db:5432/dependshield_db

# JWT signing secret. Must be long (≥ 32 chars), random, and secret.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# CORS allowed origin — the URL that the browser will use to reach the frontend.
# In production, set this to your actual frontend domain.
CORS_ORIGIN=http://localhost:80

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Host port for the Nginx frontend (default 80).
FRONTEND_PORT=80

# Absolute URL the browser uses to reach the backend API.
# In the Docker setup, nginx proxies /api/* to the backend container,
# so this should be the public URL of the frontend + /api/v1.
# If the frontend is on port 80: http://localhost:3000/api/v1 (direct)
# or set to relative proxy path via nginx.
VITE_API_URL=http://localhost:3000/api/v1

# ─── GitHub Integration (optional) ────────────────────────────────────────────
# Required for scanning private GitHub repositories.
# Public repositories work without a token (subject to GitHub rate limits).
GITHUB_TOKEN=

# ─── NVD API Key (optional but strongly recommended) ──────────────────────────
# Without a key, NVD API requests are rate-limited to ~5 requests/30s.
# Register at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
