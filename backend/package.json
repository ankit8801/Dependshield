{
  "name": "backend",
  "version": "1.0.0",
  "description": "DependShield Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --testTimeout=10000",
    "test:unit": "jest tests/unit --testTimeout=10000",
    "test:integration": "jest tests/integration --testTimeout=10000",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 10000
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "semver": "^7.8.5",
    "uuid": "^9.0.1",
    "winston": "^3.10.0",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4"
  }
}
